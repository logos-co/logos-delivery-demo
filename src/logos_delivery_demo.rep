class LogosDeliveryDemo
{
    PROP(QString connectionStatus="initializing" READONLY)
    PROP(bool nodeReady=false READONLY)
    PROP(QString lastError="" READONLY)
    PROP(QString peerId="" READONLY)
    PROP(QString multiaddrs="" READONLY)
    PROP(QString deliveryVersion="" READONLY)

    PROP(bool rlnConfigured=false READONLY)
    PROP(QString rlnMembershipState="" READONLY)
    PROP(QString rlnMembershipHash="" READONLY)
    PROP(int rlnRateLimit=0 READONLY)
    PROP(int rlnRemaining=-1 READONLY)
    PROP(QString rlnEpochIndex="" READONLY)
    PROP(int rlnEpochSizeSec=0 READONLY)
    PROP(QString rlnStatus="" READONLY)
    PROP(int rlnProofs=0 READONLY)
    PROP(int rlnValidations=0 READONLY)

    SIGNAL(messageReceived(QString topic, QString payload, QString messageHash, qint64 timestamp))
    SIGNAL(messageSentNotif(QString requestId, QString messageHash, qint64 timestamp))
    SIGNAL(messagePropagatedNotif(QString requestId, QString messageHash, qint64 timestamp))
    SIGNAL(messageErrorNotif(QString requestId, QString messageHash, QString errorText, qint64 timestamp))
    SIGNAL(channelMessageReceived(QString channelId, QString senderId, QString payload, qint64 timestamp))
    SIGNAL(channelMessageSentNotif(QString channelId, QString requestId, qint64 timestamp))
    SIGNAL(channelMessageErrorNotif(QString channelId, QString requestId, QString errorText, qint64 timestamp))
    SIGNAL(connectionStateChangedNotif(QString connectionStatus, qint64 timestamp))
    SIGNAL(nodeStartedNotif(bool success, QString message, qint64 timestamp))
    SIGNAL(nodeStoppedNotif(bool success, QString message, qint64 timestamp))
    SIGNAL(rlnProofRequested(QString signalHex, qint64 epochTimestamp, qint64 timestamp))
    SIGNAL(rlnValidationRequested(QString signalHex, qint64 epochTimestamp, qint64 timestamp))
    SIGNAL(rlnMembershipTransition(QString membershipHash, QString state, QString previous))

    SLOT(QString configureRln(QString registryId, QString rlnIdentifier, QString epochSizeSec))
    SLOT(QString createNode(QString preset, QString mode, QString anonymityLevel))
    SLOT(QString createNodeWithConfig(QString configJson))
    SLOT(QString subscribe(QString topic))
    SLOT(QString unsubscribe(QString topic))
    SLOT(QString sendMessage(QString topic, QString payloadHex))
    SLOT(QString channelCreate(QString channelId, QString contentTopic, QString senderId))
    SLOT(QString channelExists(QString channelId))
    SLOT(QString channelSend(QString channelId, QString payloadHex))
    SLOT(QString channelClose(QString channelId))
}
